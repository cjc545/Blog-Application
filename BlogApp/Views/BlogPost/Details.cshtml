@model BlogPost

@{
	ViewData["Title"] = Model.Title;
}

<div class="container">
	<div class="row justify-content-center">
		<div class="col-md-8">
			<div class="card shadow-lg mt-4">
				<div class="card-body">
					<h1 class="text-center">@Model.Title</h1>
					<p class="text-muted text-center">By <strong>@Model.User.Name.ToString()</strong> | Published on @Model.PublishedDate.ToString("MMMM dd, yyyy")</p>
					<hr />

					<div class="content">
						<p>@Html.Raw(Model.Content)</p>
					</div>

					<hr />
					<h3>Comments</h3>

					@if (Model.Comments.Any())
					{
						<ul class="list-group">
							@foreach(var comment in Model.Comments)
							{
								<li class="list-group-item">
									<strong>@comment.Author</strong> (@comment.CreateAt.ToString("dd MMM, yyyy"))<br />
									@comment.Content
								</li>
							}
						</ul>
					}
					else
					{
						<p>No comments yet.</p>
					}
					<hr />
					<h4>Add a Comment</h4>
					<form asp-controller="Comments" asp-action="Create" method="post">
						<input type="hidden" name="PostId" value="@Model.ID" />
						<div class="mb-3">
							<label class="form-label">Comment</label>
							<textarea name="UserComments" class="form-control" required></textarea>
						</div>
						<button type="submit" class="btn btn-primary">Submit</button>
					</form>
					<a href="@ViewBag.ReturnUrl" class="btn btn-secondary">Back</a>

					@* <a asp-controller="BlogPost" asp-action="Index" class="btn btn-secondary mt-3">Back to Blog</a> *@
				</div>
			</div>
		</div>
	</div>
</div>