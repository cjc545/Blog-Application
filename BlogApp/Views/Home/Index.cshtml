@model List<BlogPost>

@{
	ViewData["Title"] = "Home - Blogapp";
}
<hr />
<h1 class="text-center mb-4">Welcome to Blog Application</h1>

@if (!Model.Any())
{
	<p class="text-center">No posts avalible yet</p>
}
else
{
	<div class="row">
		@foreach (var post in Model)
		{
			<div class="card h-100 w-100" style="max-width: 300px; height: 400px;">
				<div class="card-body d-flex flex-column">
					<h5 class="card-title">@post.Title</h5>
					<p class="text-muted">By @post.User.Name.ToString() on @post.PublishedDate.ToString("yyyy-MM-dd")</p>
					<p class="card-text">
						@if (post.Content.Length > 100)
						{
							@post.Content.Substring(0, 100) <text>...</text>
						}
						else
						{
							@post.Content
						}
					</p>
					<div class="mt-auto">
						<a asp-controller="BlogPost" asp-action="Details" asp-route-id="@post.ID" class="btn btn-primary w-100">Read More</a>
					</div>
				</div>
			</div>
		}

	</div>
}